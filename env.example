# /opt/infra/.env on the server (mode 600). The API keys are NOT here: scripts/compose.sh reads them
# from kosh's /opt/kosh/selfhost/.env first (README, "Secrets").

# The API's public name; Caddy gets its Let's Encrypt certificate. Set by host-setup.sh.
SITE_ADDRESS=141-148-39-45.sslip.io

# The curator key for kosh's /admin pages: the same value as ADMIN_KEY in Vercel.
ADMIN_KEY=

# Optional: pin an older app build (rollback), by commit SHA.
# KOSH_TAG=
# SEARCH_TAG=
